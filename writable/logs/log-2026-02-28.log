 1 SYSTEMPATH\Database\BaseConnection.php(769): CodeIgniter\Database\MySQLi\Connection->execute('INSERT INTO `news` (`author_id`, `title`, `slug`, `content`, `category_id`, `state_id`, `district_id`, `mandal_id`, `village_name`, `featured_image`, `status`, `created_at`, `updated_at`) VALUES (\'1\', \'బంగారు రుద్రాక్షమాల, హారం విరాళంగా సమర్పణ\', \'బంగారు-రుద్రాక్షమాల-హారం-విరాళంగా-సమర్పణ\', \'<p><strong>శ్రీశైల దేవస్థానానికి బాపట్ల దాతల అందజేత</strong></p><p>శ్రీశైల దేవస్థానానికి బాపట్లకు చెందిన కూరపాటి మాధవి మరియు కుటుంబ సభ్యులు బంగారు రుద్రాక్షమాల, బంగారు హారాన్ని విరాళంగా సమర్పించారు.</p><p>&nbsp;</p><p><img src=\\"http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-1024x457.jpeg\\" alt=\\"\\" srcset=\\"http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-1024x457.jpeg 1024w, http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-300x134.jpeg 300w, http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-768x343.jpeg 768w, http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-1536x685.jpeg 1536w, http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM-600x268.jpeg 600w, http://ntodaynews.com/wp-content/uploads/2026/02/WhatsApp-Image-2026-02-28-at-3.47.39-PM.jpeg 1600w\\" sizes=\\"100vw\\" width=\\"640\\" height=\\"286\\"></p><p>దాతలు తెలిపిన వివరాల ప్రకారం, 43 గ్రాముల బంగారంతో రుద్రాక్షమాలతో పాటు త్రిశూలం, ఢమరుకం రూపొందించగా, 30 గ్రాముల బంగారంతో హారాన్ని తయారు చేయించారు.</p><p>&nbsp;</p><p>అమ్మవారి ఆలయ ప్రాంగణంలోని ఆశీర్వచన మండపంలో ఈ ఆభరణాలను పర్యవేక్షకులు జి. రవికుమార్, ఆలయ ఇన్‌స్పెక్టర్ కె. మల్లికార్జునులకు అందజేశారు. అనంతరం దాతలకు రశీదు అందజేసి వేదాశీర్వచనం చేసి శ్రీస్వామి అమ్మవార్ల శేషవస్త్రాలు, ప్రసాదాలు అందించారు.</p><p>— కార్యనిర్వహణాధికారి ఉత్తర్వుల మేరకు<br>శ్రీశైల దేవస్థానం ద్వారా జారీ</p><p>&nbsp;</p><p>#Srisailam #TempleDonation #GoldenRudraksha #DevotionalOffering #AndhraPradeshNews</p>\', NULL, NULL, NULL, NULL, \'\', \'\', \'pending\', \'2026-02-28 17:15:30\', \'2026-02-28 17:15:30\')')
