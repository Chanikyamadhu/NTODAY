#--------------------------------------------------------------------
# ENVIRONMENT (ఎర్రర్ ఏంటో తెలియడానికి ఇది ముఖ్యం)
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP (మీ లోకల్ సర్వర్ URL)
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/NToday-News/public/'
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE (మీ MySQL వివరాలు ఇక్కడ ఇవ్వండి)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = ntodaynews
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION (సెషన్స్ పని చేయడానికి ఇది అవసరం)
#--------------------------------------------------------------------
# కమాండ్ లైన్ లో 'php spark key:generate' రన్ చేస్తే ఇది వస్తుంది లేదా ఏదైనా రాండమ్ స్ట్రింగ్ ఇవ్వండి
encryption.key = hex2bin:848293672937492374923749237492374